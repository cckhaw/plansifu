# --- Public (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server / scraper only (NEVER expose to the browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Claude API key: the scrapers use Claude Haiku to turn rendered page text into structured plans
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional: only needed if you set SCRAPE_ENGINE=firecrawl
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# GitHub Actions only: Vercel deploy hook triggered after each crawl
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/xxx
